{
  "name": "rehabflow",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/check-offline.mjs && node scripts/check-contrast.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/make-icons.mjs",
    "check:offline": "node scripts/check-offline.mjs",
    "test:e2e": "node scripts/e2e-smoke.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@preact/signals": "^2.11.3",
    "dexie": "^4.4.6",
    "fflate": "^0.8.3",
    "lucide-preact": "^1.50.0",
    "preact": "^11.0.0",
    "uplot": "^1.6.32",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.4",
    "fake-indexeddb": "^6.2.5",
    "playwright-core": "^1.56.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3",
    "workbox-window": "^7.4.1"
  }
}
